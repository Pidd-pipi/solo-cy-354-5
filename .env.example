# CampusMarket Docker Compose 环境变量示例
# 用法：cp .env.example .env，然后按需修改

# Compose 项目名，同时作为容器名前缀
COMPOSE_PROJECT_NAME=lpcampusmarket

# MySQL 数据库配置
DB_NAME=lpcampusmarket_db
DB_USER=lpcampusmarket_user
DB_PASSWORD=lpcampusmarket_pwd
DB_ROOT_PASSWORD=lpcampusmarket_root

# 后端 JWT 与业务配置
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_HOURS=72
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT_PER_MIN=10
SEEDING_ENABLED=true
# 一次性面交码有效期（分钟）
HANDOVER_CODE_TTL_MINUTES=30

# 端口映射
FRONTEND_PORT=28514
BACKEND_PORT=29514
DB_PORT=3306
